# Dockerignore file for Najaspad
# Ignore build artifacts
target/
!target/*.jar

# Ignore IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Ignore Maven wrapper jar (will be downloaded)
.mvn/wrapper/maven-wrapper.jar

# Ignore logs
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore git
.git/
.gitignore

# Ignore Docker files (don't need them in the image)
Dockerfile*
docker-compose*.yml

# Ignore documentation
*.md
!README.md

